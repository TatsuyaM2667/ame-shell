# ame-shell の ghostty の既定設定(session/ame-terminal が --config-file で渡す)。
# 自分の ~/.config/ghostty/config があれば、そちらだけが使われる(この設定は使わない)。
# 書き方: ghostty +show-config --default --docs

# ---- シェル: fastfetch を出してから zsh(ame-shell の設定)----
command = ame-term-shell
# プロンプトの位置などの連携は zsh の設定(share/ame-shell/zsh/.zshrc)が読み込む
shell-integration = none
shell-integration-features = cursor,title

# ---- 見た目: foot(share/ame-shell/xdg/foot/foot.ini)と同じ。半透明の夜空色に壁紙が透ける ----
# 文字(foot と同じ並び: 英数字 → 日本語 → アイコン)
font-family = JetBrains Mono
font-family = Noto Sans Mono CJK JP
font-family = Symbols Nerd Font
font-size = 12
font-thicken = false

# 色: 背景は foot の alpha=0.65 と同じ見た目の透け具合(ghostty は少し薄く出るので 0.7)。文字の背景色(ls の色など)も同じだけ透かす
background = #060913
foreground = #cdd6f4
background-opacity = 0.7
background-opacity-cells = true
# River にはぼかしの仕組みが無い(付けても効かず、foot と見た目がずれる)
background-blur = false
cursor-color = #cdd6f4
cursor-style = bar
cursor-style-blink = true
selection-background = #89b4fa
selection-foreground = #060913
# 16 色(foot と同じ)
palette = 0=#45475a
palette = 1=#f38ba8
palette = 2=#a6e3a1
palette = 3=#f9e2af
palette = 4=#89b4fa
palette = 5=#f5c2e7
palette = 6=#7fdceb
palette = 7=#bac2de
palette = 8=#585b70
palette = 9=#f38ba8
palette = 10=#a6e3a1
palette = 11=#f9e2af
palette = 12=#89b4fa
palette = 13=#f5c2e7
palette = 14=#94e2d5
palette = 15=#a6adc8

# ---- 窓 ----
window-padding-x = 24
window-padding-y = 24
window-padding-balance = false
# タイル型の WM なのでタイトルバーは要らない(枠は ame-shell が描く)
window-decoration = false
gtk-titlebar = false
resize-overlay = never
confirm-close-surface = false
# 2 つ目からの窓をすぐ開けるよう、1 つのプロセスで複数の窓を持つ
gtk-single-instance = true
# 最後の窓を閉じても少しの間は残し、次に開くのを速く
quit-after-last-window-closed = true
quit-after-last-window-closed-delay = 5m

# ---- 操作 ----
mouse-hide-while-typing = true
copy-on-select = clipboard
app-notifications = no-clipboard-copy
keybind = ctrl+shift+t=new_tab
keybind = ctrl+shift+enter=new_split:auto
keybind = ctrl+shift+w=close_surface
keybind = ctrl+plus=increase_font_size:1
keybind = ctrl+minus=decrease_font_size:1
keybind = ctrl+zero=reset_font_size
