// ame-shell 既定設定。~/.config/ame-shell/config.ame にコピーして編集すると、保存した瞬間に反映されます。
// 文法: セクション { キー 値 }   値は数値 / "文字列" / 単語 / #RRGGBB / on|off

shell {
  layout caelestia          // caelestia(枠とドロワー)| classic(横バー)
  ui-scale 1.25
  super-launcher on         // Super を単独で押して離すとランチャー
  tap-to-click on           // タッチパッドのタップでクリック(River 0.5 のセッション。変更はログインし直すと反映)
  charge-animation on       // 充電器をつないだとき、画面全体に充電のリングを出す(iPhone の MagSafe のように)
  // weather-location "Sapporo"  // 天気の場所(省略すると IP アドレスから推定)
}

theme {
  accent #7ab8ff          // アクセント色
  tint #0b1730            // ガラスの色
  tint-strength 0.42      // ガラスの色の濃さ(0〜1)
  text #eaf2ff
  subtext #9fb4d6
  radius 18               // 角丸
  blur 3                  // ブラーの強さ(1〜4)
  refraction 10           // 縁の屈折(px)
  sparkle 0.7             // ガラスのきらめき(0で無効)
  anim-speed 1.0          // アニメ速度の倍率
  media-accent on         // 再生中のアルバムアートの色をアクセントにする
}

bar {
  height 38
  margin 8
  position top            // top | bottom
  clock-24h on
  show-seconds off        // on にすると毎秒再描画(省電力のため既定は off)
}

wallpaper {
  mode aurora             // aurora | rain | image
  // image "~/Pictures/wallpaper.jpg"
  animate on              // off で完全に静止(待機時 CPU ほぼ 0)
  fps 30                  // AC 電源時
  battery-fps 12          // バッテリー時(解像度も 3/4 に下がる)
  scale 0.5               // ライブ壁紙の内部解像度
  aurora-a #29d6b0
  aurora-b #3d7bff
  aurora-c #9a5cff
}

font {
  ui "Noto Sans CJK JP"
  icon "JetBrainsMono Nerd Font Propo"
}

apps {
  terminal ame-terminal         // ghostty(無ければ foot)。session/ame-terminal
}

notifications {
  timeout 6000            // ms
  battery on              // バッテリーの残りが 20% / 10% / 5% になったら知らせる
  usb on                  // USB の機器を挿した・抜いたら知らせる
}

lock {
  enabled on
}

// 歌詞の取り寄せ先(上から順に探し、同期歌詞が見つかったら終わり)
lyrics {
  music-tui on            // music-tui の歌詞サーバ。on なら ~/music-tui-bsd/.env の WORKERS_URL を使う(URL を直接書いてもよい)
  lrclib on               // LRCLIB(lrclib.net)
  netease on              // NetEase Cloud Music(非公式の公開 API。日本語の曲に強い)
  kugou on                // 酷狗(Kugou。日本語・中国語の曲の同期歌詞が多い)
}

// ハンド操作: カメラに映った手の動きでカーソルと窓を操作する(ユーティリティのボタン・ame-ctl hand toggle でも切り替え)
hand {
  enabled off             // on なら起動したときからオン
  trail on                // 指の軌跡に光る波を立てる
  // camera "/dev/video0" // 使うカメラ(省略すると /dev/video* から自動で選ぶ)
}

// AirPods の頭の動きで操作する(AirPods Pro 2 など。Linux のみ。ame-ctl airpods on|off、ユーティリティの「AirPods 操作」)
//   頭を右/左へ振って戻す → 右/左のワークスペース、上を向いて戻す → ランチャー、下を向いて戻す → ダッシュボード
//   振ったまま・向いたまま(よそ見・キーボードを見る)では何もしない。AirPods 本来の操作(軸を押す・つまむ)もそのまま使える
airpods {
  enabled off
  yaw-angle 25            // 左右に振ったとみなす角度(度)
  pitch-angle 18          // 上下に向いたとみなす角度(度)
  invert-yaw off          // 左右が逆に動くときは on
  invert-pitch off        // 上下が逆に動くときは on
}

// 顔認証: 登録した顔がカメラに写ったらロックを外す(パスワードもそのまま使える。赤外線カメラを優先)
face {
  enabled on              // 顔を登録してあれば、ロック画面で顔を見てロックを外す(登録: ランチャーの「顔を登録」か ame-ctl face enroll)
  threshold 0.6           // 一致とみなす近さ(0.5〜0.95。上げるほど厳しい)
  require_ir on           // 赤外線カメラでだけ使う(スマホの画面の写真では外れない)。普通のカメラしか無いときだけ off
  // camera "/dev/video2" // 使うカメラ(省略すると赤外線カメラを自動で選ぶ)
}

// ホーム画面の曲のウィジェット: ロック画面と同じ曲のカードを、デスクトップの四隅のどこかに置く(窓の下。曲が無いときは出さない)。
// カードの何もない所をつかんでドラッグすると、近い隅へ動かせる(覚える)。ame-ctl widget music <隅|on|off>
music-widget {
  enabled on
  corner bottom-right     // top-left / top-right / bottom-left / bottom-right
}
