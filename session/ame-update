#!/bin/sh
# ame-update: OS のパッケージと ame-shell 自体をまとめて更新する。POSIX sh のみ。
#
#   ame-update             パッケージ → ame-shell(git pull → ビルド → インストール)→ 動いている ame-shell を再起動
#   ame-update --check     更新があるかを表示するだけ(何も変えない)
#   ame-update --no-pkg    パッケージは更新しない
#   ame-update --no-self   ame-shell は更新しない
#   ame-update --force     ame-shell に新しいコミットが無くても作り直す
#   ame-update --debug     デバッグ情報つきでビルド(--debug で入れた場合の更新はこちら)
#   ame-update --yes       確認しない
#
# 対応: FreeBSD(pkg)と Chimera Linux(apk)。ほかのディストリはパッケージの更新だけ飛ばす。
# root が必要な作業は doas → sudo → su の順に使える方で行う(パスワードを聞かれる)。

set -u
CHECK=0
DO_PKG=1
DO_SELF=1
FORCE=0
ASSUME_YES=0
BUILD_OPTS="-Doptimize=ReleaseFast"
for a in "$@"; do
    case "$a" in
        --check) CHECK=1 ;;
        --no-pkg) DO_PKG=0 ;;
        --no-self) DO_SELF=0 ;;
        --force) FORCE=1 ;;
        --debug) BUILD_OPTS="-Doptimize=ReleaseSafe -Dstrip=false" ;;
        --yes|-y) ASSUME_YES=1 ;;
        -h|--help) sed -n '2,15p' "$0"; exit 0 ;;
        *) echo "unknown option: $a" >&2; exit 2 ;;
    esac
done

say() { printf '\n==> %s\n' "$*"; }
info() { printf '    %s\n' "$*"; }
die() { printf 'ERROR: %s\n' "$*" >&2; exit 1; }
confirm() {
    [ "$ASSUME_YES" = 1 ] || [ ! -t 0 ] && return 0
    printf '%s [Y/n] ' "$1"
    read -r ans || ans=y
    case "$ans" in [nN]*) return 1 ;; *) return 0 ;; esac
}

OS=$(uname -s)
OS_ID=""
[ -f /etc/os-release ] && OS_ID=$(. /etc/os-release 2>/dev/null; echo "${ID:-}")

# ---- root で実行する(doas → sudo → su) ----
as_root() {
    if [ "$(id -u)" -eq 0 ]; then "$@"
    elif command -v doas >/dev/null 2>&1; then doas "$@"
    elif command -v sudo >/dev/null 2>&1; then sudo "$@"
    else
        # su -c は 1 つの文字列を取るので、引数を引用付きでつなげる
        cmd=""
        for x in "$@"; do cmd="$cmd '$x'"; done
        echo "(root のパスワードを入力してください)"
        su root -c "$cmd"
    fi
}

# ---- ame-shell のソースの場所: $AME_SOURCE → インストール時の記録 → ~/ame-shell ----
case "$0" in */*) SELF_DIR=$(cd "$(dirname "$0")" && pwd) ;; *) SELF_DIR=$(dirname "$(command -v "$0")") ;; esac
PREFIX_DIR=$(dirname "$SELF_DIR")
SRC="${AME_SOURCE:-}"
[ -n "$SRC" ] || SRC=$(head -n 1 "$PREFIX_DIR/share/ame-shell/source" 2>/dev/null || true)
[ -n "$SRC" ] && [ -f "$SRC/build.zig" ] || SRC="$HOME/ame-shell"
# ソースの中から直接実行された(sh ~/ame-shell/session/ame-update。ame-update をまだ入れていない古いインストール):
# ログイン画面から使っている ame-session の場所に入れ直す
if [ -f "$PREFIX_DIR/build.zig" ]; then
    SRC=$PREFIX_DIR
    inst=$(command -v ame-session 2>/dev/null || true)
    case "$inst" in
        */bin/ame-session) PREFIX_DIR=$(dirname "$(dirname "$inst")") ;;
        *) PREFIX_DIR=/usr/local ;;
    esac
fi

# ---------------------------------------------------------------------------
if [ "$DO_PKG" = 1 ]; then
    say "1/3 パッケージ"
    if [ "$OS" = FreeBSD ]; then
        as_root pkg update -q || info "pkg update に失敗しました(続けます)"
        if [ "$CHECK" = 1 ]; then
            out=$(as_root pkg upgrade -n 2>/dev/null | sed -n '/^Installed packages to be UPGRADED/,/^$/p')
            if [ -n "$out" ]; then printf '%s\n' "$out" | sed 's/^/    /'; else info "パッケージは最新です"; fi
        elif confirm "パッケージを更新しますか?"; then
            as_root pkg upgrade -y || info "pkg upgrade に失敗しました(続けます)"
        fi
        # 後から使うようになったもの(fastfetch: 端末を開いたときの表示、wlr-randr: 画面の拡大率、wf-recorder: 録画、mpv・ffmpeg: 動画の壁紙)
        missing=""
        for p in fastfetch wlr-randr wf-recorder mpv ffmpeg; do pkg info -e "$p" || missing="$missing $p"; done
        if [ -n "$missing" ] && [ "$CHECK" = 0 ]; then
            info "追加のパッケージ:$missing"
            as_root pkg install -y $missing || info "pkg install に失敗しました(続けます)"
        fi
    elif [ "$OS_ID" = chimera ] && command -v apk >/dev/null 2>&1; then
        as_root apk update >/dev/null 2>&1 || info "apk update に失敗しました(続けます)"
        if [ "$CHECK" = 1 ]; then
            apk upgrade --simulate 2>/dev/null | sed 's/^/    /' || true
        elif confirm "パッケージを更新しますか?"; then
            as_root apk upgrade || info "apk upgrade に失敗しました(続けます)"
        fi
    else
        info "このディストリのパッケージ更新には対応していません(手動で更新してください)"
    fi
fi

# ---------------------------------------------------------------------------
UPDATED=0
if [ "$DO_SELF" = 1 ]; then
    say "2/3 ame-shell"
    [ -f "$SRC/build.zig" ] || die "ame-shell のソースが見つかりません($SRC)。AME_SOURCE=<git clone した場所> を指定してください"
    info "ソース: $SRC"
    command -v git >/dev/null 2>&1 || die "git がありません"
    git -C "$SRC" fetch -q || info "git fetch に失敗しました(ネットワークを確認してください)"
    local_rev=$(git -C "$SRC" rev-parse HEAD)
    remote_rev=$(git -C "$SRC" rev-parse '@{u}' 2>/dev/null || echo "$local_rev")
    # 入っている版(インストール時に記録したコミット。記録の無い古いインストールは空 = 古い版とみなす)
    installed_rev=$(sed -n 2p "$PREFIX_DIR/share/ame-shell/source" 2>/dev/null || true)
    stale=0
    [ "$installed_rev" != "$remote_rev" ] && stale=1
    if [ "$local_rev" != "$remote_rev" ]; then
        info "新しい変更:"
        git -C "$SRC" log --oneline "HEAD..@{u}" 2>/dev/null | head -n 20 | sed 's/^/      /'
    elif [ "$stale" = 1 ]; then
        info "ソースは最新ですが、入っている ame-shell($PREFIX_DIR/bin)は古い版です$( [ "$CHECK" = 1 ] && echo "(ame-update で入れ直せます)" || echo "。ビルドして入れ直します")"
    else
        info "ame-shell は最新です($(git -C "$SRC" log -1 --format='%h %s' | cut -c1-70))"
    fi
    if [ "$CHECK" = 0 ] && { [ "$local_rev" != "$remote_rev" ] || [ "$stale" = 1 ] || [ "$FORCE" = 1 ]; }; then
        if [ -n "$(git -C "$SRC" status --porcelain --untracked-files=no)" ]; then
            info "ソースに手元の変更があるため git pull はしません(手元の変更を守るため)。今のソースでビルドします"
        elif [ "$local_rev" != "$remote_rev" ]; then
            git -C "$SRC" pull --ff-only -q || die "git pull に失敗しました(手元のコミットと分岐しています)"
        fi
        # ツールチェイン: インストール時に用意したもの(FreeBSD は /usr/local/ame-toolchain、Linux は PATH か ~/.cache)
        ZIG=""
        ODIN=""
        for z in "$(command -v zig 2>/dev/null)" /usr/local/ame-toolchain/zig-0.13.0/bin/zig "$HOME/.cache/ame-shell/toolchain/zig-linux-$(uname -m)-0.13.0/zig"; do
            [ -n "$z" ] && [ -x "$z" ] && [ "$("$z" version 2>/dev/null)" = 0.13.0 ] && { ZIG=$z; break; }
        done
        for o in "$(command -v odin 2>/dev/null)" /usr/local/ame-toolchain/odin-dev-2026-08/odin "$HOME/.cache/ame-shell/toolchain/odin-dev-2026-08/odin"; do
            [ -n "$o" ] && [ -x "$o" ] && { ODIN=$o; break; }
        done
        if [ -z "$ZIG" ] || [ -z "$ODIN" ]; then
            info "ビルド用のツール(Zig 0.13 / Odin)が見つからないため、インストーラを実行します"
            sh "$SRC/install.sh" --yes
            UPDATED=1
        else
            info "ビルドします($BUILD_OPTS)"
            (cd "$SRC" && PATH="$(dirname "$ZIG"):$(dirname "$ODIN"):$PATH" "$ZIG" build $BUILD_OPTS) || die "ビルドに失敗しました"
            # この ame-update が入っている場所に入れ直す(ホームの下なら自分用、それ以外は全ユーザー用)
            case "$PREFIX_DIR" in
                "$HOME"/*)
                    sh "$SRC/session/install-session.sh" --user --prefix "$PREFIX_DIR" >/dev/null || die "インストールに失敗しました" ;;
                *)
                    as_root sh "$SRC/session/install-session.sh" --prefix "$PREFIX_DIR" >/dev/null || die "インストールに失敗しました" ;;
            esac
            info "インストールしました"
            UPDATED=1
        fi
    fi
    # 追加の壁紙(非公開リポジトリ。GitHub にログインしていなければ案内だけ)
    [ "$CHECK" = 0 ] && [ -f "$SRC/scripts/fetch-wallpapers.sh" ] && sh "$SRC/scripts/fetch-wallpapers.sh"
    # FreeBSD: foot・fastfetch の設定を ame-shell のものに(元のファイルは *.ame-bak に残る)
    [ "$CHECK" = 0 ] && [ "$OS" = FreeBSD ] && [ -f "$SRC/scripts/app-config.sh" ] && sh "$SRC/scripts/app-config.sh"
fi

# FreeBSD: タッチパッド・Bluetooth のドライバ(後から追加した設定。まだなら root で設定する。反映は再起動後)
# ame-shell を更新した後に行う(1 回目の ame-update でも新しいスクリプトを使えるように)
if [ "$OS" = FreeBSD ] && [ "$CHECK" = 0 ] && [ "$DO_PKG" = 1 ]; then
    case " $(sysrc -n kld_list 2>/dev/null) " in
        *" iichid "*) ;;
        *) [ -f "$SRC/scripts/freebsd-touchpad.sh" ] && { say "タッチパッド"; as_root sh "$SRC/scripts/freebsd-touchpad.sh"; } ;;
    esac
    case " $(sysrc -n kld_list 2>/dev/null) " in
        *" ng_ubt "*) ;;
        *) [ -f "$SRC/scripts/freebsd-bluetooth.sh" ] && { say "Bluetooth"; as_root sh "$SRC/scripts/freebsd-bluetooth.sh"; } ;;
    esac
    # ログイン画面(SDDM)の背景を今の壁紙に(同じ壁紙なら何もしない)
    [ -f "$SRC/scripts/sddm-theme.sh" ] && as_root sh "$SRC/scripts/sddm-theme.sh" --user "$(id -un)"
fi

# ---------------------------------------------------------------------------
say "3/3 再起動"
if [ "$UPDATED" = 1 ] && command -v ame-ctl >/dev/null 2>&1 && ame-ctl stats >/dev/null 2>&1; then
    ame-ctl restart >/dev/null && info "動いている ame-shell を新しい版で起動し直しました(窓とワークスペースはそのまま)"
elif [ "$UPDATED" = 1 ]; then
    info "次にログインしたときから新しい版になります"
else
    info "(ame-shell の再起動は不要です)"
fi
if [ "$DO_PKG" = 1 ] && [ "$CHECK" = 0 ] && [ "$OS" = FreeBSD ]; then
    info "カーネルやドライバ(drm-kmod など)が更新された場合は再起動してください: shutdown -r now"
fi
