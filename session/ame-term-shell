#!/bin/sh
# ame-term-shell: ame-shell の端末(ghostty / foot の既定設定の command / shell)から起動されるシェル。
# 端末を開いたら最初に fastfetch でシステムの情報を出し、それから zsh(無ければいつものシェル $SHELL)になる。POSIX sh。
#   - zsh / bash は、自分の ~/.zshrc / ~/.bashrc が無ければ ame-shell の設定(share/ame-shell/zsh/.zshrc・bash/bashrc:
#     ユーザー名@ホスト名・場所・git の状態の 2 行のプロンプト、補完、履歴)で起動する。
#   - シェルは AME_TERM_SHELL で選べる(例: ~/.config/ame-shell/environment に export AME_TERM_SHELL=bash)
#   - fastfetch が無い、AME_FASTFETCH=0、すでに出した(FASTFETCH_SHOWN)ときは出さない
#   - シェルの設定ファイルで自分で fastfetch を呼んでいる場合も、二重にならないよう出さない

# 窓の大きさが決まる(タイル配置される)まで少し待つ。決まる前に出すと、配置し直しで表示が崩れる
wait_size() {
    prev=""
    i=0
    while [ $i -lt 12 ]; do
        cur=$(stty size 2>/dev/null)
        case "$cur" in
            ""|"0 "*|*" 0") ;;
            *) [ "$cur" = "$prev" ] && [ $i -ge 3 ] && return ;;
        esac
        prev=$cur
        sleep 0.05
        i=$((i + 1))
    done
}

if [ -z "${FASTFETCH_SHOWN:-}" ] && [ "${AME_FASTFETCH:-1}" != 0 ] && command -v fastfetch >/dev/null 2>&1 &&
    ! grep -qs fastfetch "$HOME/.profile" "$HOME/.shrc" "$HOME/.bashrc" "$HOME/.zshrc" "$HOME/.cshrc" \
        "$HOME/.tcshrc" "$HOME/.config/fish/config.fish"; then
    wait_size
    fastfetch
fi
FASTFETCH_SHOWN=1
export FASTFETCH_SHOWN

case "$0" in
    */*) SELF_DIR=$(cd "$(dirname "$0")" && pwd) ;;
    *) SELF_DIR=$(dirname "$(command -v "$0")") ;;
esac
ZSHDIR="$(dirname "$SELF_DIR")/share/ame-shell/zsh"
BASHRC="$(dirname "$SELF_DIR")/share/ame-shell/bash/bashrc"
[ -f "$BASHRC" ] || BASHRC="$SELF_DIR/../data/bash/bashrc"
[ -d "$ZSHDIR" ] || ZSHDIR="$SELF_DIR/../data/zsh"

# 使うシェル: AME_TERM_SHELL → zsh → $SHELL
sh_cmd="${AME_TERM_SHELL:-}"
if [ -z "$sh_cmd" ] && command -v zsh >/dev/null 2>&1; then sh_cmd=$(command -v zsh); fi
case "$sh_cmd" in
    */zsh|zsh)
        export SHELL="$sh_cmd"
        # 自分の設定が無ければ ame-shell の設定で(ZDOTDIR は zsh が .zshrc を探す場所)
        if [ -z "${ZDOTDIR:-}" ] && [ ! -f "$HOME/.zshrc" ] && [ -f "$ZSHDIR/.zshrc" ]; then
            export ZDOTDIR="$ZSHDIR"
        fi
        exec "$sh_cmd" -l
        ;;
    */bash|bash)
        export SHELL="$sh_cmd"
        # 自分の ~/.bashrc が無ければ ame-shell の設定(zsh と同じ見た目)で
        if [ ! -f "$HOME/.bashrc" ] && [ -f "$BASHRC" ]; then exec "$sh_cmd" --rcfile "$BASHRC" -i; fi
        exec "$sh_cmd" -i
        ;;
    ?*) exec "$sh_cmd" ;;
esac

# 自分自身を $SHELL にされていても、ループせずにふつうのシェルにする
case "${SHELL:-}" in
    ""|*/ame-term-shell|ame-term-shell) SHELL=/bin/sh; export SHELL ;;
esac
exec "$SHELL"
